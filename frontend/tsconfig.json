{
  "compilerOptions": {
    "baseUrl": ".",
    "allowSyntheticDefaultImports": true,
    "noImplicitAny": true,
    "module": "ES2022",
    "target": "ES2022",
    "moduleResolution": "bundler",
    "allowJs": true,
    "sourceMap": true,
    "paths": {
      "scripts/*": ["src/scripts/*"],
    }
  },
  "include": ["./src"]
}
